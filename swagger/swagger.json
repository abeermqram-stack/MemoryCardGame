{
  "openapi": "3.0.1",
  "info": {
    "title": "MemoryGameApi",
    "version": "1.0",
    "description": "ASP.NET Core Web API (.NET 8) + EF Core Code-First — لعبة بطاقات الذاكرة (Memory Card Game)"
  },
  "servers": [
    {
      "url": "/MemoryCardGame"
    }
  ],
  "paths": {
    "/api/Cards": {
      "get": {
        "tags": ["Cards"],
        "summary": "Get all cards",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": ["Cards"],
        "summary": "Add a new card",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CardItem" }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/Cards/level/{level}": {
      "get": {
        "tags": ["Cards"],
        "summary": "Get active cards by level (1 = 6 pairs, 2 = 10 pairs)",
        "parameters": [
          {
            "name": "level",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 2, "default": 1 }
          }
        ],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/Cards/search": {
      "get": {
        "tags": ["Cards"],
        "summary": "Search cards by title or category",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "الفضاء" }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "Bad Request" }
        }
      }
    },
    "/api/Cards/{id}": {
      "get": {
        "tags": ["Cards"],
        "summary": "Get card by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32", "minimum": 1, "default": 1 }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" }
        }
      },
      "put": {
        "tags": ["Cards"],
        "summary": "Update card by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32", "minimum": 1, "default": 1 }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CardItem" }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" }
        }
      },
      "delete": {
        "tags": ["Cards"],
        "summary": "Delete card by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32", "minimum": 1 }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" }
        }
      }
    },
    "/api/Cards/{id}/update-title": {
      "put": {
        "tags": ["Cards"],
        "summary": "Update only card title using UpdateCardTitleDto",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32", "minimum": 1, "default": 1 }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateCardTitleDto" }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "Bad Request" },
          "404": { "description": "Not Found" }
        }
      }
    },
    "/api/GameSessions": {
      "get": {
        "tags": ["GameSessions"],
        "summary": "Get all game sessions ordered by score",
        "responses": {
          "200": { "description": "OK" }
        }
      },
      "post": {
        "tags": ["GameSessions"],
        "summary": "Add a completed game session (updates profile stats & unlocks achievements)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GameSession" }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/GameSessions/paged": {
      "get": {
        "tags": ["GameSessions"],
        "summary": "Get paged game sessions with optional level filter",
        "parameters": [
          {
            "name": "pageIndex",
            "in": "query",
            "schema": { "type": "integer", "format": "int32", "default": 1 }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": { "type": "integer", "format": "int32", "default": 10 }
          },
          {
            "name": "level",
            "in": "query",
            "schema": { "type": "integer", "format": "int32", "nullable": true }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "Bad Request" }
        }
      }
    },
    "/api/GameSessions/{id}": {
      "get": {
        "tags": ["GameSessions"],
        "summary": "Get game session by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32", "minimum": 1, "default": 1 }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" }
        }
      },
      "put": {
        "tags": ["GameSessions"],
        "summary": "Update game session by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32", "minimum": 1, "default": 1 }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GameSession" }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" }
        }
      },
      "delete": {
        "tags": ["GameSessions"],
        "summary": "Delete game session by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32", "minimum": 1 }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" }
        }
      }
    },
    "/api/Players": {
      "get": {
        "tags": ["Players"],
        "summary": "Get all players with Profile (1:1), GameSessions (1:N), and Achievements (N:M)",
        "responses": {
          "200": { "description": "OK" }
        }
      },
      "post": {
        "tags": ["Players"],
        "summary": "Register a new player",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Player" }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/Players/{id}": {
      "get": {
        "tags": ["Players"],
        "summary": "Get player by ID with all relationships",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32", "minimum": 1, "default": 1 }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" }
        }
      },
      "put": {
        "tags": ["Players"],
        "summary": "Update player by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32", "minimum": 1, "default": 2 }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Player" }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" }
        }
      },
      "delete": {
        "tags": ["Players"],
        "summary": "Delete player by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32", "minimum": 1 }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" }
        }
      }
    },
    "/api/Players/login": {
      "get": {
        "tags": ["Players"],
        "summary": "Login player or admin with email & password",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "asia@memorygame.sa" }
          },
          {
            "name": "password",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "123456" }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" }
        }
      }
    },
    "/api/Players/search/{keyword}": {
      "get": {
        "tags": ["Players"],
        "summary": "Search players by name or email",
        "parameters": [
          {
            "name": "keyword",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "asia" }
          }
        ],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CardItem": {
        "type": "object",
        "required": ["title", "icon", "category", "accentColor"],
        "properties": {
          "cardId": { "type": "integer", "format": "int32", "example": 0 },
          "title": { "type": "string", "maxLength": 80, "example": "قمر فضي" },
          "icon": { "type": "string", "maxLength": 150, "example": "🌙" },
          "category": { "type": "string", "maxLength": 60, "example": "الفضاء" },
          "accentColor": { "type": "string", "maxLength": 30, "example": "#6366f1" },
          "levelDifficulty": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 2, "example": 1 },
          "isActive": { "type": "boolean", "example": true }
        }
      },
      "UpdateCardTitleDto": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "maxLength": 80, "example": "صاروخ المستقبل" }
        }
      },
      "GameSession": {
        "type": "object",
        "required": ["level", "pairsCount", "attempts", "timeElapsedSeconds", "score", "playerId"],
        "properties": {
          "sessionId": { "type": "integer", "format": "int32", "example": 0 },
          "level": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 2, "example": 1 },
          "pairsCount": { "type": "integer", "format": "int32", "minimum": 6, "maximum": 10, "example": 6 },
          "attempts": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 1000, "example": 8 },
          "timeElapsedSeconds": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 7200, "example": 25 },
          "score": { "type": "integer", "format": "int32", "minimum": 0, "maximum": 100000, "example": 950 },
          "isCompleted": { "type": "boolean", "example": true },
          "playedAt": { "type": "string", "format": "date-time" },
          "playerId": { "type": "integer", "format": "int32", "example": 2 }
        }
      },
      "Player": {
        "type": "object",
        "required": ["username", "email", "password", "role"],
        "properties": {
          "playerId": { "type": "integer", "format": "int32", "example": 0 },
          "username": { "type": "string", "maxLength": 100, "example": "لاعبة جديدة" },
          "email": { "type": "string", "format": "email", "maxLength": 150, "example": "newplayer@memorygame.sa" },
          "password": { "type": "string", "maxLength": 100, "example": "123456" },
          "role": { "type": "string", "maxLength": 30, "example": "Player" },
          "createdAt": { "type": "string", "format": "date-time" },
          "profile": { "$ref": "#/components/schemas/PlayerProfile" }
        }
      },
      "PlayerProfile": {
        "type": "object",
        "properties": {
          "profileId": { "type": "integer", "format": "int32" },
          "avatarEmoji": { "type": "string", "maxLength": 20, "example": "🎮" },
          "preferredTheme": { "type": "string", "maxLength": 50, "example": "Neon Space" },
          "highestScore": { "type": "integer", "format": "int32" },
          "totalGamesPlayed": { "type": "integer", "format": "int32" },
          "playerId": { "type": "integer", "format": "int32" }
        }
      },
      "Achievement": {
        "type": "object",
        "properties": {
          "achievementId": { "type": "integer", "format": "int32" },
          "title": { "type": "string", "maxLength": 100 },
          "description": { "type": "string", "maxLength": 250 },
          "badgeIcon": { "type": "string", "maxLength": 20 },
          "bonusPoints": { "type": "integer", "format": "int32" }
        }
      }
    }
  }
}
