  "components": {
    "schemas": {
      "Achievement": {
        "required": [
          "badgeIcon",
          "description",
          "title"
        ],
        "type": "object",
        "properties": {
          "achievementId": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 250,
            "minLength": 1,
            "type": "string"
          },
          "badgeIcon": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "bonusPoints": {
            "maximum": 5000,
            "minimum": 10,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CardItem": {
        "required": [
          "accentColor",
          "category",
          "icon",
          "title"
        ],
        "type": "object",
        "properties": {
          "cardId": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "icon": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "category": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string"
          },
          "accentColor": {
            "maxLength": 30,
            "minLength": 1,
            "type": "string"
          },
          "levelDifficulty": {
            "maximum": 2,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "GameSession": {
        "required": [
          "attempts",
          "level",
          "pairsCount",
          "playerId",
          "score",
          "timeElapsedSeconds"
        ],
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "integer",
            "format": "int32"
          },
          "level": {
            "maximum": 2,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "pairsCount": {
            "maximum": 10,
            "minimum": 6,
            "type": "integer",
            "format": "int32"
          },
          "attempts": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "timeElapsedSeconds": {
            "maximum": 7200,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "score": {
            "maximum": 100000,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "isCompleted": {
            "type": "boolean"
          },
          "playedAt": {
            "type": "string",
            "format": "date-time"
          },
          "playerId": {
            "type": "integer",
            "format": "int32"
          },
          "player": {
            "$ref": "#/components/schemas/Player"
          }
        },
        "additionalProperties": false
      },
      "Player": {
        "required": [
          "email",
          "password",
          "role",
          "username"
        ],
        "type": "object",
        "properties": {
          "playerId": {
            "type": "integer",
            "format": "int32"
          },
          "username": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "maxLength": 30,
            "minLength": 1,
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "profile": {
            "$ref": "#/components/schemas/PlayerProfile"
          },
          "gameSessions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GameSession"
            },
            "nullable": true
          },
          "playerAchievements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlayerAchievement"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PlayerAchievement": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "integer",
            "format": "int32"
          },
          "achievementId": {
            "type": "integer",
            "format": "int32"
          },
          "achievement": {
            "$ref": "#/components/schemas/Achievement"
          },
          "unlockedAt": {
            "type": "string",
            "format": "date-time"
          },
          "displayOrder": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "PlayerProfile": {
        "required": [
          "avatarEmoji",
          "preferredTheme"
        ],
        "type": "object",
        "properties": {
          "profileId": {
            "type": "integer",
            "format": "int32"
          },
          "avatarEmoji": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "preferredTheme": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "highestScore": {
            "maximum": 100000,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "totalGamesPlayed": {
            "maximum": 10000,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "playerId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "UpdateCardTitleDto": {
        "required": [
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}